{
  "name": "redline",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "pnpm --filter @redline/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:corpus": "vitest run --project corpus",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "license-audit": "node scripts/license-audit.mjs",
    "fixtures:out": "pnpm --filter @redline/pdf-core fixtures:out"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.14.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.2",
    "globals": "^17.12.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@napi-rs/canvas"
    ]
  }
}
